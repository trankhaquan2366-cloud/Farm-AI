# ===================================
# Server & App Configuration
# ===================================
PROJECT_NAME="GreenFarm AI Backend"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ===================================
# Database Configuration
# ===================================
# Dùng SQLite (mặc định thử nghiệm)
DATABASE_URL=sqlite:///./farm.db

# Dùng PostgreSQL (khi triển khai thật)
# DATABASE_URL=postgresql://user:password@localhost:5432/greenfarm_db

# ===================================
# Security & JWT Authentication
# ===================================
# Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===================================
# CORS Settings (Cấu hình kết nối Frontend)
# ===================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===================================
# AI & External API Keys (Nếu có)
# ===================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here