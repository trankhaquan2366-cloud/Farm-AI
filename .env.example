# ===================================
# Server & App Configuration
# ===================================
PROJECT_NAME="GreenFarm AI Backend"
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ===================================
# Database Configuration
# ===================================
# Dùng SQLite (mặc định thử nghiệm)
DATABASE_URL=sqlite:///./farm.db

# Dùng PostgreSQL (khi triển khai thật)
# DATABASE_URL=postgresql://user:password@localhost:5432/greenfarm_db

# ===================================
# Security & JWT Authentication
# ===================================
# BẮT BUỘC khi DEBUG=False: ứng dụng sẽ từ chối khởi động nếu thiếu.
# Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===================================
# CORS Settings (Cấu hình kết nối Frontend)
# ===================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===================================
# AI & External API Keys (Nếu có)
# ===================================
GEMINI_API_KEY=your_gemini_api_key_here
# Model dùng cho 4 chức năng AI. Nên dùng alias "-latest" để không gãy khi
# Google ngừng một phiên bản; đổi sang model khác nếu hết hạn mức miễn phí.
GEMINI_MODEL=gemini-flash-lite-latest
# Thời gian chờ tối đa cho một lần gọi AI (giây). Mặc định 30.
GEMINI_TIMEOUT_SECONDS=30

# ===================================
# Demo & chống brute-force
# ===================================
# Mật khẩu dùng khi tạo tài khoản demo (create_admin.py / scripts/demo_data.py).
# Để trống sẽ báo lỗi thay vì dùng mật khẩu mặc định đã biết.
DEMO_PASSWORD=
# Số lần đăng nhập tối đa mỗi phút cho một IP. Mặc định 5.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ===================================
# Dashboard
# ===================================
# true (mặc định): nếu lô đã có harvest_logs trong cùng ngày thì bỏ qua nhật ký
# "Thu hoạch" tương ứng để biểu đồ không cộng trùng sản lượng.
# Đặt false nếu muốn cộng cả hai nguồn (không khuyến nghị).
DASHBOARD_DEDUPE_HARVEST=true
OPENAI_API_KEY=your_openai_api_key_here